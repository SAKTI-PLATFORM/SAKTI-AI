APP_ENV=development
PORT=8001

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=12000
DEEPSEEK_TIMEOUT_SECONDS=120

# ── Langfuse Observability ──────────────────────────────
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ── JobMatcher ──────────────────────────────────────────
MATCH_THRESHOLD=0.70

# ── TalentForger ────────────────────────────────────────
MIN_RESOURCES_PER_GAP=3

# ── Brave Search (LLM Context API) ──────────────────────
# Get your key at: https://api.search.brave.com/app/dashboard
BRAVE_API_KEY=<your-brave-api-key>
# Token budget per search call (1024-32768). Keep low for fast agent responses.
BRAVE_MAX_TOKENS=4096
# Max URLs returned per search call (1-50).
BRAVE_MAX_URLS=5
